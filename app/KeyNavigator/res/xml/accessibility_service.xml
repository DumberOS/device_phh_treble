<!-- Include structural containers: BankID's ButtonGrid is otherwise omitted.
     This physical-key input aid declares itself an accessibility tool so Android
     can expose views marked accessibility-data-sensitive to the service. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowsChanged|typeWindowContentChanged|typeViewScrolled|typeViewFocused"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds|flagRequestFilterKeyEvents|flagIncludeNotImportantViews|flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:canRequestFilterKeyEvents="true"
    android:canPerformGestures="true"
    android:isAccessibilityTool="true"
    android:notificationTimeout="0"
    android:description="@string/service_description"
    android:settingsActivity="com.dumbermini.keynavigator.SetupActivity" />
