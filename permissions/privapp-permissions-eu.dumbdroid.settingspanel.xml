<?xml version="1.0" encoding="utf-8"?>
<permissions>
<privapp-permissions package="eu.dumbdroid.settingspanel">
    <!-- Allow toggling secure settings like AIRPLANE_MODE and WRITE_SECURE_SETTINGS -->
    <permission name="android.permission.WRITE_SECURE_SETTINGS" />
    <permission name="android.permission.WRITE_SETTINGS" />
    <!-- Allow changing the DND policy without user prompt -->
    <permission name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <permission name="android.permission.MODIFY_PHONE_STATE" />
    <permission name="android.permission.CHANGE_NETWORK_STATE" />
    <permission name="android.permission.STATUS_BAR_SERVICE" />

</privapp-permissions>
</permissions>
